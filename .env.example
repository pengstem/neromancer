# Neromancer 统一 AI API 配置（复制为 .env 后填入真实 Key）
# 获取 Key / 查看可用模型: https://moark.com/
DEEPSEEK_API_KEY=

# API Base URL（默认模力方舟 MoArk 端点，也兼容 DeepSeek 官方端点）
DEEPSEEK_BASE_URL=https://api.moark.com

# 默认核心模型（支持文本 + 图像多模态理解）
# 可选: deepseek-v4.1-flash | DeepSeek-V4-Pro | DeepSeek-V4-Flash | deepseek-flash
DEEPSEEK_MODEL=deepseek-v4.1-flash

# 本地数据目录（JSON Vault 数据、录音/图片原始证据、导出卡片）
NEROMANCER_DATA_DIR=./data
