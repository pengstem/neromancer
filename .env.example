# Neromancer 统一 DeepSeek API 配置（复制为 .env 后填入真实 Key）
# 获取 Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# DeepSeek API Base URL（默认官方端点，无需改动）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认核心模型（支持文本 + 图像多模态理解）
# 可选: deepseek-flash | deepseek-v4-pro | deepseek-chat | deepseek-reasoner
DEEPSEEK_MODEL=deepseek-flash

# 本地数据目录（SQLite 数据库、录音/图片原始证据、导出卡片）
NEROMANCER_DATA_DIR=./data
